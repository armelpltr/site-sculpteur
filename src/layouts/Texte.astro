---
import Base from '@/layouts/Base.astro';

interface Props {
  titre: string;
  description?: string;
  surtitre?: string;
}
const { titre, description, surtitre } = Astro.props;
---

<Base titre={titre} description={description}>
  <article class="conteneur max-w-3xl pt-14 sm:pt-20">
    {surtitre && <p class="surtitre">{surtitre}</p>}
    <h1 class="mt-3 text-4xl sm:text-5xl">{titre}</h1>
    <div class="prose prose-neutral mt-10 max-w-none prose-headings:font-serif prose-headings:font-normal prose-a:decoration-trait prose-a:underline-offset-4">
      <slot />
    </div>
  </article>
</Base>
