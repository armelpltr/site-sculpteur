---
import { getCollection, render } from 'astro:content';
import Base from '@/layouts/Base.astro';

const toutes = await getCollection('expositions');
const fmt = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' });
const periode = (debut: Date, fin?: Date) => (fin ? `Du ${fmt.format(debut)} au ${fmt.format(fin)}` : fmt.format(debut));

const elements = await Promise.all(
  toutes
    .sort((a, b) => b.data.debut.getTime() - a.data.debut.getTime())
    .map(async (e) => ({ entree: e, Content: (await render(e)).Content })),
);
// Classement « à venir / passées » au moment du build ; le script en bas
// de page le recalcule dans le navigateur pour rester juste entre deux builds.
const maintenant = Date.now();
const finDe = (e: (typeof toutes)[number]) => (e.data.fin ?? e.data.debut).getTime() + 86_400_000;
---

<Base titre="Expositions et actualités" description="Expositions à venir et passées, salons et actualités de l'atelier.">
  <div class="conteneur pt-14 sm:pt-20">
    <p class="surtitre">Agenda</p>
    <h1 class="mt-3 text-4xl sm:text-6xl">Expositions & actualités</h1>
  </div>

  {
    (['avenir', 'passees'] as const).map((groupe) => (
      <section class="conteneur mt-16" data-groupe={groupe}>
        <h2 class="text-3xl">{groupe === 'avenir' ? 'À venir' : 'Passées'}</h2>
        <ol class="liste mt-6 divide-y divide-trait border-y border-trait">
          {elements
            .filter(({ entree }) => (finDe(entree) >= maintenant) === (groupe === 'avenir'))
            .map(({ entree, Content }) => (
              <li class="evenement grid gap-2 py-6 md:grid-cols-[14rem_1fr] md:gap-8" data-fin={finDe(entree)} data-debut={entree.data.debut.getTime()}>
                <div class="text-sm text-encre-douce">
                  <time datetime={entree.data.debut.toISOString().slice(0, 10)}>{periode(entree.data.debut, entree.data.fin)}</time>
                  <p class="mt-1 text-xs tracking-[0.15em] uppercase">{entree.data.type}</p>
                </div>
                <div>
                  <h3 class="text-2xl">{entree.data.titre}</h3>
                  <p class="text-sm text-encre-douce">{entree.data.lieu}, {entree.data.ville}</p>
                  <div class="prose prose-neutral mt-3 max-w-none text-sm">
                    <Content />
                  </div>
                  {entree.data.lien && <a class="lien mt-2 inline-block text-sm" href={entree.data.lien} rel="noopener" target="_blank">En savoir plus</a>}
                </div>
              </li>
            ))}
        </ol>
        <p class="vide hidden py-6 text-sm text-encre-douce">Aucun événement pour le moment.</p>
      </section>
    ))
  }
</Base>

<script>
  function reclasser() {
    const avenir = document.querySelector('[data-groupe="avenir"] .liste');
    const passees = document.querySelector('[data-groupe="passees"] .liste');
    if (!avenir || !passees) return;
    const maintenant = Date.now();
    const tous = [...document.querySelectorAll<HTMLElement>('.evenement')];
    const parDate = (sens: number) => (a: HTMLElement, b: HTMLElement) => sens * (Number(a.dataset.debut) - Number(b.dataset.debut));
    tous.filter((e) => Number(e.dataset.fin) >= maintenant).sort(parDate(1)).forEach((e) => avenir.append(e));
    tous.filter((e) => Number(e.dataset.fin) < maintenant).sort(parDate(-1)).forEach((e) => passees.append(e));
    for (const liste of [avenir, passees]) {
      const vide = liste.children.length === 0;
      liste.classList.toggle('hidden', vide);
      liste.nextElementSibling?.classList.toggle('hidden', !vide);
    }
  }
  document.addEventListener('astro:page-load', reclasser);
</script>
