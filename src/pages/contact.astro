---
import Base from '@/layouts/Base.astro';
import { site } from '@/config/site';

const formspree = site.formulaire.service === 'formspree';
const action = formspree ? `https://formspree.io/f/${site.formulaire.formspreeId}` : '/merci';
---

<Base titre="Contact" description={`Contacter ${site.nom} : demande d'information sur une œuvre, visite d'atelier, commande.`}>
  <div class="conteneur grid gap-16 pt-14 sm:pt-20 md:grid-cols-[2fr_3fr]">
    <section>
      <p class="surtitre">Contact</p>
      <h1 class="mt-3 text-4xl sm:text-6xl">Écrire à l'atelier</h1>
      <p class="mt-6 text-encre-douce">
        Une question sur une œuvre, une visite d'atelier ou une commande&nbsp;? Je vous réponds personnellement.
      </p>
      <dl class="mt-10 space-y-6 text-sm">
        <div>
          <dt class="surtitre">E-mail</dt>
          <dd class="mt-1"><a class="lien" href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        {
          site.telephone && (
            <div>
              <dt class="surtitre">Téléphone</dt>
              <dd class="mt-1"><a class="lien" href={`tel:${site.telephone.replace(/\s/g, '')}`}>{site.telephone}</a></dd>
            </div>
          )
        }
        <div>
          <dt class="surtitre">Atelier</dt>
          <dd class="mt-1">{site.atelier}<br />{site.ville}</dd>
        </div>
        {
          site.reseaux.instagram && (
            <div>
              <dt class="surtitre">Instagram</dt>
              <dd class="mt-1">
                <a class="lien" href={site.reseaux.instagram} rel="me noopener" target="_blank">Suivre le travail en cours</a>
              </dd>
            </div>
          )
        }
      </dl>
    </section>

    <section id="formulaire" class="scroll-mt-24">
      <form
        name="contact"
        method="POST"
        action={action}
        data-netlify={formspree ? undefined : 'true'}
        netlify-honeypot={formspree ? undefined : 'adresse-web'}
        class="space-y-8"
        data-astro-reload
      >
        {!formspree && <input type="hidden" name="form-name" value="contact" />}
        <p class="hidden">
          <label>Ne pas remplir : <input name="adresse-web" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="grid gap-8 sm:grid-cols-2">
          <label class="block">
            <span class="surtitre">Nom *</span>
            <input class="champ" name="nom" autocomplete="name" required />
          </label>
          <label class="block">
            <span class="surtitre">E-mail *</span>
            <input class="champ" type="email" name="email" autocomplete="email" required />
          </label>
        </div>
        <label class="block">
          <span class="surtitre">Œuvre concernée</span>
          <input class="champ" name="oeuvre" id="champ-oeuvre" placeholder="Facultatif" />
        </label>
        <label class="block">
          <span class="surtitre">Message *</span>
          <textarea class="champ min-h-40 resize-y" name="message" id="champ-message" rows="6" required></textarea>
        </label>
        <label class="flex items-start gap-3 text-sm text-encre-douce">
          <input type="checkbox" name="consentement" required class="mt-1 h-4 w-4 accent-[var(--color-accent)]" />
          <span>
            J'accepte que mes données soient utilisées pour répondre à ma demande, conformément à la
            <a class="lien" href="/confidentialite">politique de confidentialité</a>. *
          </span>
        </label>
        {formspree && <input type="hidden" name="_next" value={new URL('/merci', Astro.site).href} />}
        <button type="submit" class="bouton-plein">Envoyer</button>
      </form>
    </section>
  </div>
</Base>

<script>
  // Préremplissage depuis le bouton « Demander des informations » d'une fiche œuvre.
  function preremplir() {
    const titre = new URLSearchParams(location.search).get('oeuvre');
    const oeuvre = document.querySelector<HTMLInputElement>('#champ-oeuvre');
    const message = document.querySelector<HTMLTextAreaElement>('#champ-message');
    if (!titre || !oeuvre || !message) return;
    oeuvre.value = titre;
    if (!message.value) {
      message.value = `Bonjour,\n\nJe souhaiterais avoir des informations sur l'œuvre « ${titre} ».\n\n`;
    }
    message.focus();
    message.setSelectionRange(message.value.length, message.value.length);
  }
  document.addEventListener('astro:page-load', preremplir);
</script>
